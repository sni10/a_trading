########################################
# Пример локального .env для прототипа #
########################################

# Логическое окружение запуска (local/dev/prod и т.п.)
# По умолчанию: local
# APP_ENV=local

# Максимальное количество тиков за один запуск демо-конвейера.
# По умолчанию: 10
MAX_TICKS=100

# Пауза между тиками в секундах.
# По умолчанию: 0.2
TICK_SLEEP_SEC=0.2

# Интервалы обновления индикаторов (в количестве тиков).
# Значения по умолчанию: 1 / 3 / 5
# INDICATOR_FAST_INTERVAL=1
# INDICATOR_MEDIUM_INTERVAL=3
# INDICATOR_HEAVY_INTERVAL=5


# ========================================
# Database Configuration
# ========================================
# DATABASE_TYPE: Backend БД ('sqlite' или 'postgresql')
# - sqlite: локальная БД в файле (по умолчанию)
# - postgresql: PostgreSQL через SQLAlchemy
DATABASE_TYPE=postgresql

# DATABASE_PATH: Путь к SQLite файлу (только для DATABASE_TYPE=sqlite)
# DATABASE_PATH=data/deviant.db

# DATABASE_URL: Строка подключения к PostgreSQL (обязательно для DATABASE_TYPE=postgresql)
# Формат: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/atrading

# DB_SCHEMA: Схема PostgreSQL (опционально, по умолчанию 'public')
# ВНИМАНИЕ: Схема должна быть создана в БД вручную или через миграции!
DB_SCHEMA=main

# ========================================
# Docker Compose Environment Variables
# ========================================
# Эти переменные используются docker-compose.yml для настройки контейнера PostgreSQL
POSTGRES_DB=atrading
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
