########################################
# Пример локального .env для прототипа #
########################################

# Логическое окружение запуска (local/dev/prod и т.п.)
# По умолчанию: local
# APP_ENV=local

# Максимальное количество тиков за один запуск демо-конвейера.
# По умолчанию: 10
MAX_TICKS=100

# Пауза между тиками в секундах.
# По умолчанию: 0.2
TICK_SLEEP_SEC=0.2

# Интервалы обновления индикаторов (в количестве тиков).
# Значения по умолчанию: 1 / 3 / 5
# INDICATOR_FAST_INTERVAL=1
# INDICATOR_MEDIUM_INTERVAL=3
# INDICATOR_HEAVY_INTERVAL=5


# ========================================
# Database Configuration (OPTIONAL)
# ========================================
# DATABASE_TYPE: Database backend to use ('sqlite' or 'postgresql')
# - sqlite: Local SQLite database (default, no additional setup required)
# - postgresql: PostgreSQL database via SQLAlchemy (requires DATABASE_URL)
DATABASE_TYPE=sqlite

# DATABASE_PATH: Path to SQLite database file (used when DATABASE_TYPE=sqlite)
DATABASE_PATH=data/deviant.db

# DATABASE_URL: PostgreSQL connection string (required when DATABASE_TYPE=postgresql)
# Format: postgresql://username:password@host:port/database
# Example: postgresql://deviant_user:password@localhost:5432/deviant
# DATABASE_URL=postgresql://username:password@localhost:5432/deviant
